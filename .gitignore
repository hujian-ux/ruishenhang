# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/
*.local

# Env
.env
.env.local
.env.*.local

# 构建/分发产物（非源码，勿入仓库）
*.zip
dist/
build/

# Editor
.idea/
.vscode/
.DS_Store

# local runtime artifacts
logs/
pytest_live.log

# 运行时报告（由 scripts/ingest_corpus.py 与 scripts/eval_baseline.py 重跑生成）
backend/reports/

# 浏览器自动化 / TS 增量构建缓存
.playwright-cli/
*.tsbuildinfo

# 运行时数据（embedding 缓存 sqlite / qdrant 本地文件）
backend/data/

# Feast 在线特征服务运行时产物（本地 SQLite 在线存储 / 注册表 / 同步 parquet）
backend/feast_repo/registry.db
backend/feast_repo/online_store.db
backend/feast_repo/data/

# M17 离线装包缓存（pip 走代理取不到 index 时的轮子暂存目录）
backend/wheels/

# 本地截图用的开发登录跳板（绕过登录，禁止入库）
web/public/__devlogin.html
web/public/__measure.html

# 真实语料投递包（客户制度/SOP 可能涉密）——除占位文件外一律不入库。
# 目录结构保留，方便 clone 后直接拖文件；用户放进去的 docx/pdf/xlsx 全部忽略。
corpus_inbox/raw/**
corpus_inbox/converted/**
!corpus_inbox/raw/
!corpus_inbox/converted/
!corpus_inbox/raw/**/
!corpus_inbox/converted/**/
!corpus_inbox/**/PLACE_FILES_HERE.txt

# MLOps 训练产物（数据集 csv / 模型 joblib）——运行时生成，不入库
mlops_artifacts/

# 临时/工具状态目录（不入库）
.tmp/
.dumate/

# 自动生成的 OpenAPI 文档（FastAPI 重跑即变，勿入仓库）
openapi.yaml
