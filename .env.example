# 企业 AI 智能体中台 · 后端环境变量（单体运行）
# 复制为 .env 后按需修改。密钥仅用于本地开发，生产请走密钥管理。

# 服务
APP_NAME=enterprise-ai-platform
APP_ENV=dev
API_PREFIX=/api/v1

# PostgreSQL（对应 docker-compose postgres）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=aiplat
PG_USER=app
PG_PASSWORD=dev

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# MinIO（文件/附件网关，第23章）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=kb-files

# Redis（会话/语义缓存，第40章）
REDIS_URL=redis://127.0.0.1:6379/0

# LiteLLM 模型网关（第25章）
LITELLM_BASE_URL=http://127.0.0.1:4000

# 模型接入决策：中文 Embedding 选 bge（bge-m3，维度 1024）
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 第18章单一过滤点：服务端签名密钥（前端不可伪造 X-Caller-Context）
CALLER_SIGNING_SECRET=dev-only-change-me

# 默认租户（演示）
DEFAULT_TENANT=t_demo

# ── M17 真模型接入（两条通道，业务代码不感知）──
# litellm：经 LiteLLM 代理（多厂商统一账单，生产推荐）
# direct ：直连厂商 OpenAI 兼容端点（单厂商起步最快，不起额外容器）
LLM_PROVIDER=direct
LLM_VENDOR=zhipu
# 留空则按 LLM_VENDOR 取默认端点（zhipu/dashscope/openai/deepseek/moonshot）
LLM_BASE_URL=
# 留空则读厂商惯用环境变量（zhipu→ZHIPU_API_KEY，dashscope→DASHSCOPE_API_KEY …）
LLM_API_KEY=
LLM_DEFAULT_MODEL=glm-4.6
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=180
# 生产/验收必须置 1：真模型失败直接报错，绝不拿 stub 冒充结果
LLM_STRICT=0
# GLM-4.5/4.6 默认混合思考；结构化表格任务建议关掉（更快更稳更省）
LLM_DISABLE_THINKING=1
# 合同价与牌价常不同：{"glm-4.6": [0.004, 0.014]}（元/1k tokens，[输入, 输出]）
MODEL_PRICES_JSON=
