# 企业 AI 智能体中台 · 后端环境变量（单体运行）
# 复制为 .env 后按需修改。密钥仅用于本地开发，生产请走密钥管理。

# 服务
APP_NAME=enterprise-ai-platform
APP_ENV=dev
API_PREFIX=/api/v1

# PostgreSQL（对应 docker-compose postgres）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=aiplat
PG_USER=app
PG_PASSWORD=dev

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# MinIO（文件/附件网关，第23章）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=kb-files

# Redis（会话/语义缓存，第40章）
REDIS_URL=redis://127.0.0.1:6379/0

# LiteLLM 模型网关（第25章）
LITELLM_BASE_URL=http://127.0.0.1:4000

# 模型接入决策：中文 Embedding 选 bge（bge-m3，维度 1024）
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# 第18章单一过滤点：服务端签名密钥（前端不可伪造 X-Caller-Context）
CALLER_SIGNING_SECRET=dev-only-change-me

# 默认租户（演示）
DEFAULT_TENANT=t_demo
