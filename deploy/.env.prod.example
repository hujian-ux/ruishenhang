# 生产部署环境变量（复制为仓库根 .env 后填写）
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile app up -d 会读取本文件。

# ── Caddy / 域名 ──
SITE_DOMAIN=ai.your-domain.com          # 你的域名（A 记录已指向本机公网 IP，且 80/443 开放）
CADDY_EMAIL=admin@your-domain.com       # Let's Encrypt 证书联系邮箱

# ── 后端：生产收口 ──
APP_ENV=prod
AUTH_ENFORCE_OIDC=1                      # 必须=1：禁用 dev_admin 后门，强制真实 SSO（Casdoor）

# ── 持久化（可选；不填则后端内存模式，重启丢数据）──
# 启用后取消注释，并确保基础 compose 的 backend 取消 depends_on 注释、开启对应 environment。
# POSTGRES_DSN=postgresql://app:你的密码@postgres:5432/aiplat
# QDRANT_HOST=qdrant
# MINIO_ENDPOINT=minio:9000
# REDIS_URL=redis://redis:6379/0

# ── 外部密钥（按需）──
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# LITELLM_MASTER_KEY=
