.chip { display:inline-block; padding:10rpx 20rpx; margin:8rpx 8rpx 8rpx 0; border:1rpx solid #2a4a78; border-radius:24rpx; font-size:24rpx; color:#b9c8e0; }
.chip.on { background:#2f6bff; color:#fff; border-color:#2f6bff; }
.input { width:100%; height:160rpx; background:#0b1f3a; color:#e8eef7; border:1rpx solid #2a4a78; border-radius:12rpx; padding:16rpx; box-sizing:border-box; }
.reply { margin-top:16rpx; padding:16rpx; background:#0b1f3a; border-radius:12rpx; font-size:26rpx; white-space:pre-wrap; }
.err { color:#ff7a7a; font-size:24rpx; margin-top:12rpx; }
