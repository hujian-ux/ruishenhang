<view class="card">
  <view class="title">睿深行 AI 工作台</view>
  <view class="muted">企业智能体中台 · 把 115 个业务技能交到每位员工手里</view>
  <view style="height:24rpx"></view>

  <view wx:if="{{!enforce}}">
    <view class="btn" bindtap="devLogin" data-admin="{{false}}">员工视角（演示）</view>
    <view class="btn ghost" bindtap="devLogin" data-admin="{{true}}">管理员视角（演示）</view>
  </view>
  <view wx:else>
    <view class="muted">身份已收口，请走企业统一身份登录。</view>
    <view style="height:16rpx"></view>
    <view wx:if="{{wxEnabled}}">
      <view class="btn" bindtap="wxLogin">微信一键登录</view>
      <view class="muted" style="margin-top:8rpx">将以微信身份直接登录（无需密码）。</view>
    </view>
    <view wx:else class="muted">本端未启用微信身份源，请联系管理员配置 WX_MINI_LOGIN_ENABLED。</view>
  </view>

  <view wx:if="{{err}}" class="err">{{err}}</view>
</view>
