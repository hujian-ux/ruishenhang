# 睿深行 AI 工作台 · 前端静态托管（Vite 产物 dist/）示例
# 复制并按需修改 server_name / root；HTTPS 必需（PWA 安装 + 小程序 request 域名均要求 HTTPS）。
server {
    listen 80;
    server_name ai.your-domain.com;                 # 改成你的域名
    root /var/www/enterprise-ai-platform/dist;      # 改成 dist 实际绝对路径
    index index.html;

    # SPA history 回退：深链接（如 /chat/xxx）刷新不会 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带 contenthash 的静态资源可长缓存（Vite 默认命名）
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # PWA：sw.js 禁止缓存（每次拉最新），manifest 明确 MIME
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Content-Type "application/manifest+json";
    }

    # 同源部署时，可把 /api 反代到后端单体（替代跨域 CORS）：
    # location /api/ {
    #     proxy_pass http://127.0.0.1:8080;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
}

# HTTPS：用 Certbot（Let's Encrypt）申请证书后，新增 443 server 并做 80→443 跳转。
# 示例（443 段，仅骨架，证书路径以 certbot 输出为准）：
