# M6 实机验证环境变量模板
# 用法：cd D:\enterprise-ai-platform ; Copy-Item .env.m6.example .env ; notepad .env
# 注意：.env 已被 .gitignore 忽略，密钥不会进仓库。

# ── 大模型密钥（至少填一个；都填也行）──
# 通义千问（阿里云百炼 DashScope）——国内直连，推荐
DASHSCOPE_API_KEY=
# OpenAI（国内访问需代理）
OPENAI_API_KEY=

# ── 基础设施口令（与 docker-compose 默认值一致，一般不用改）──
PG_PASSWORD=dev
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ── LiteLLM 鉴权（新版默认要求；本地开发保持下面 true 即免密）──
LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY=true
# 生产改成：LITELLM_MASTER_KEY=sk-你的主密钥（后端同名环境变量会自动透传）
LITELLM_MASTER_KEY=
